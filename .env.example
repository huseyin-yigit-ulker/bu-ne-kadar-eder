# Google Gemini API anahtarı — https://aistudio.google.com/apikey adresinden alın
GEMINI_API_KEY=

# Kullanılacak model (varsayılan: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# IP başına günlük ücretsiz tarama hakkı
FREE_DAILY_LIMIT=2

# (Opsiyonel) Bot korumalı siteleri (Letgo/Sahibinden/Dolap — Akamai/DataDome)
# sunucudan çekebilmek için ticari "web unlocker" servisi.
# Tanımlanmazsa link modu bu sitelerde çalışmaz (kullanıcı eklentiye yönlendirilir).
# Sağlayıcılar: scrapingbee | scraperapi | zenrows | scrapingant | scrapfly
# SCRAPER_PROVIDER=scrapingbee
# SCRAPER_API_KEY=
