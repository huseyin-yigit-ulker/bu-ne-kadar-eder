# Google Gemini API anahtarı — https://aistudio.google.com/apikey adresinden alın
GEMINI_API_KEY=

# Kullanılacak model (varsayılan: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# IP başına günlük ücretsiz tarama hakkı
FREE_DAILY_LIMIT=2

# crawl4ai scraper servisi (gerçek headless tarayıcı — bot korumalı siteler için).
# scraper/ klasöründeki servisi çalıştırıp bu adresi tanımla.
CRAWLER_URL=http://127.0.0.1:8000

# (Opsiyonel) Benzer GERÇEK ilanları (tıklanır linkli) bulmak için arama API'si.
# Tanımlanmazsa emsaller AI tahmini olur. Sağlayıcılar: serper | brave | serpapi | google
# SEARCH_PROVIDER=serper
# SEARCH_API_KEY=
# google için ayrıca: GOOGLE_CSE_CX=

# (Opsiyonel) Bot korumalı siteleri (Letgo/Sahibinden/Dolap — Akamai/DataDome)
# sunucudan çekebilmek için ticari "web unlocker" servisi.
# Tanımlanmazsa link modu bu sitelerde çalışmaz (kullanıcı eklentiye yönlendirilir).
# Sağlayıcılar: scrapingbee | scraperapi | zenrows | scrapingant | scrapfly
# SCRAPER_PROVIDER=scrapingbee
# SCRAPER_API_KEY=
